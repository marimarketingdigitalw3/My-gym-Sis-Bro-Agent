# --- Frontend (públicas, se incluyen en el bundle) ---
# Sin estas dos variables la app arranca en "Modo demo local" (datos solo en el navegador).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Secretos de las Edge Functions (NUNCA con prefijo VITE_) ---
# Se configuran con: supabase secrets set ANTHROPIC_API_KEY=...
ANTHROPIC_API_KEY=
# Opcional: modelo a usar por Gym AI Coach
COACH_MODEL=claude-opus-5-5
# Opcional: límite de mensajes por usuario y hora
COACH_RATE_LIMIT_PER_HOUR=30
